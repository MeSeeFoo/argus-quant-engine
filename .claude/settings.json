{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(./mvnw.cmd *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git fetch *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "PowerShell(./mvnw.cmd *)",
      "PowerShell(.\\mvnw.cmd *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)",
      "PowerShell(git blame *)",
      "PowerShell(git fetch *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run list *)",
      "PowerShell(docker compose ps *)",
      "PowerShell(docker compose logs *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main*)",
      "Bash(git rebase *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push --mirror*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push * *:main*)",
      "PowerShell(git rebase *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "java",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ProtectGeneratedCode.java"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "java",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/GuardGitPush.java"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git *)",
            "command": "java",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/GuardGitPush.java"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "java",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/FormatJava.java"],
            "timeout": 180
          }
        ]
      }
    ]
  }
}
