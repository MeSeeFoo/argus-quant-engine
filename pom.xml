<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.argus</groupId>
    <artifactId>argus-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Argus Quant Engine</name>
    <description>Real-time market data, indicators and quantitative rules on a low-latency JVM pipeline.</description>
    <url>https://github.com/MeSeeFoo/argus-quant-engine</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/MeSeeFoo/argus-quant-engine</url>
        <connection>scm:git:https://github.com/MeSeeFoo/argus-quant-engine.git</connection>
    </scm>

    <modules>
        <module>contracts</module>
        <module>libs</module>
        <module>services</module>
    </modules>

    <properties>
        <!-- Toolchain -->
        <java.release>25</java.release>
        <maven.compiler.release>${java.release}</maven.compiler.release>
        <minimum.maven.version>3.9</minimum.maven.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Agrona (and therefore SBE and Aeron) needs jdk.internal.misc.Unsafe on Java 25.
             Every JVM that loads Agrona must start with this flag: tests here, services at runtime. -->
        <agrona.jvm.args>--add-exports java.base/jdk.internal.misc=ALL-UNNAMED</agrona.jvm.args>
        <!-- Set by JaCoCo to its agent; empty when JaCoCo does not run, so tests still start. -->
        <argLine></argLine>
        <!-- Coverage thresholds, checked by ./mvnw verify in every module with hand-written code -->
        <coverage.line.minimum>0.80</coverage.line.minimum>
        <coverage.branch.minimum>0.70</coverage.branch.minimum>
        <!-- SonarQube Cloud (run by CI with ./mvnw sonar:sonar). It reads the JaCoCo reports. -->
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>argus-quant-engine</sonar.organization>
        <sonar.projectKey>MeSeeFoo_argus-quant-engine</sonar.projectKey>
        <sonar.exclusions>**/target/generated-sources/**</sonar.exclusions>

        <!-- Dependencies: the only place where versions are declared -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <aeron.version>1.53.3</aeron.version>
        <agrona.version>2.7.0</agrona.version>
        <sbe.version>1.40.2</sbe.version>
        <protobuf.version>4.36.2</protobuf.version>
        <junit.version>6.1.3</junit.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <archunit.version>1.5.1</archunit.version>
        <jspecify.version>1.0.1</jspecify.version>
        <!-- Overrides the version brought by kafka-clients, which has known vulnerabilities
             (GHSA-mcr4-qmvw-px4g and others). Remove once Kafka ships 1.11.4 or newer. -->
        <lz4-java.version>1.11.4</lz4-java.version>

        <!-- Plugins -->
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <maven-wrapper-plugin.version>3.3.4</maven-wrapper-plugin.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
        <protobuf-maven-plugin.version>5.1.11</protobuf-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <error-prone.version>2.50.0</error-prone.version>
        <nullaway.version>0.14.2</nullaway.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
        <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
        <!-- 1.37.0 is not yet supported by Spotless 3.10.x -->
        <google-java-format.version>1.36.1</google-java-format.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Imported BOMs: the first declaration wins, so JUnit and Testcontainers
                 go before Spring Boot to override the versions it manages. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.argus</groupId>
                <artifactId>argus-architecture-rules</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Fast path -->
            <dependency>
                <groupId>io.aeron</groupId>
                <artifactId>aeron-client</artifactId>
                <version>${aeron.version}</version>
            </dependency>
            <dependency>
                <groupId>io.aeron</groupId>
                <artifactId>aeron-driver</artifactId>
                <version>${aeron.version}</version>
            </dependency>
            <dependency>
                <groupId>org.agrona</groupId>
                <artifactId>agrona</artifactId>
                <version>${agrona.version}</version>
            </dependency>
            <dependency>
                <groupId>uk.co.real-logic</groupId>
                <artifactId>sbe-tool</artifactId>
                <version>${sbe.version}</version>
            </dependency>

            <!-- Durable path -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- Security override, see lz4-java.version -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>

            <!-- Nullness annotations (@Nullable) checked by NullAway -->
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!-- Error Prone runs inside javac; it needs the flags in .mvn/jvm.config. -->
                        <compilerArgs>
                            <arg>-Werror</arg>
                            <arg>-XDcompilePolicy=simple</arg>
                            <arg>--should-stop=ifError=FLOW</arg>
                            <!-- Every warning fails the build. Generated sources are not checked.
                                 NullAway treats everything under com.argus as non-null unless @Nullable. -->
                            <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*[/\\]target[/\\]generated-(test-)?sources[/\\].* -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=com.argus</arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>com.google.errorprone</groupId>
                                <artifactId>error_prone_core</artifactId>
                                <version>${error-prone.version}</version>
                            </path>
                            <path>
                                <groupId>com.uber.nullaway</groupId>
                                <artifactId>nullaway</artifactId>
                                <version>${nullaway.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <argLine>@{argLine} ${agrona.jvm.args}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <argLine>@{argLine} ${agrona.jvm.args}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-wrapper-plugin</artifactId>
                    <version>${maven-wrapper-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.github.ascopes</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${protobuf-maven-plugin.version}</version>
                    <configuration>
                        <!-- protoc is downloaded from Maven Central, same version as the runtime -->
                        <protoc>${protobuf.version}</protoc>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- SBOM attached to each GitHub Release: ./mvnw cyclonedx:makeAggregateBom -->
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                    <configuration>
                        <outputName>argus-sbom</outputName>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${java.release},)</version>
                                    <message>Argus requires Java ${java.release} or newer (Eclipse Temurin recommended). Check JAVA_HOME.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[${minimum.maven.version},)</version>
                                    <message>Argus requires Maven ${minimum.maven.version} or newer. Use the Maven Wrapper: ./mvnw</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <!-- Bound to verify by default: ./mvnw verify fails on unformatted code. -->
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <!-- target/site/jacoco/jacoco.xml, also read by SonarQube -->
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
