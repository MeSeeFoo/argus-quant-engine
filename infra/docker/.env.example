# Local infrastructure settings for docker-compose.yml.
# Copy this file to .env (git-ignored) and adjust it if a port is already taken.
# These credentials are for local development only.

# --- Kafka (KRaft, single node) ---
# Clients on the host use localhost:${KAFKA_PORT}; containers use kafka:29092.
KAFKA_PORT=9092

# --- QuestDB ---
QUESTDB_HTTP_PORT=9000
QUESTDB_ILP_PORT=9009
QUESTDB_PG_PORT=8812
QUESTDB_PG_USER=admin
QUESTDB_PG_PASSWORD=quest

# --- PostgreSQL ---
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus

# --- Apicurio Registry ---
# The registry stores its schemas in its own PostgreSQL database.
APICURIO_PORT=8080
APICURIO_UI_PORT=8888
APICURIO_DB=apicurio
APICURIO_DB_USER=apicurio
APICURIO_DB_PASSWORD=apicurio

# --- Grafana LGTM (Grafana, Loki, Tempo, Prometheus, OpenTelemetry Collector) ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- Binance (feed gateway) ---
# Read-only Ed25519 API key for Binance's SBE market data stream. The feed gateway reads it
# from the environment (see services/feed-gateway/README.md); Compose does not use it yet.
# Put the real key only in .env, which is git-ignored.
BINANCE_API_KEY=
