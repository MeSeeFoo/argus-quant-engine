# Editor settings shared by every IDE. See https://editorconfig.org.
# Java formatting is enforced by Spotless (google-java-format) and line endings
# by .gitattributes; this file keeps editors consistent with both.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,proto,xml,json,yml,yaml}]
indent_size = 2

# Maven POMs use 4 spaces.
[pom.xml]
indent_size = 4

[*.md]
indent_size = 2
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

# Generated by the Maven Wrapper and by release-please: keep them as generated.
[{mvnw,mvnw.cmd,CHANGELOG.md}]
indent_style = unset
indent_size = unset
