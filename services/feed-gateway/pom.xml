<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.argus</groupId>
        <artifactId>argus-services</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>argus-feed-gateway</artifactId>

    <name>Argus :: Services :: Feed Gateway</name>
    <description>Receives market data from the venues and publishes it on the fast path (Aeron + SBE) in the canonical format.</description>

    <properties>
        <!-- Binance's spot stream schema, unchanged from github.com/binance/binance-spot-api-docs -->
        <binance.sbe.schema>${project.basedir}/src/main/sbe/binance/stream_1_0.xml</binance.sbe.schema>
        <binance.sbe.generated.dir>${project.build.directory}/generated-sources/binance-sbe</binance.sbe.generated.dir>
    </properties>

    <dependencies>
        <!-- Actuator over HTTP: health checks and metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Agents and their runners: the hot path runs on them, not on Spring -->
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
        </dependency>
        <!-- Fast path: canonical SBE messages over Aeron, with an embedded Media Driver (ADR 0021) -->
        <dependency>
            <groupId>com.argus</groupId>
            <artifactId>argus-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-driver</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.argus</groupId>
            <artifactId>argus-architecture-rules</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generates Binance's codecs from its stream schema. They stay in the gateway: the rest
                 of the system only sees the canonical contracts (ADR 0004). Sources are never committed. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-binance-codecs</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <!-- Scoped to this execution, so exec:java from the command line keeps its own main class -->
                        <configuration>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <mainClass>uk.co.real_logic.sbe.SbeTool</mainClass>
                            <systemProperties>
                                <systemProperty>
                                    <key>sbe.output.dir</key>
                                    <value>${binance.sbe.generated.dir}</value>
                                </systemProperty>
                                <systemProperty>
                                    <key>sbe.target.language</key>
                                    <value>Java</value>
                                </systemProperty>
                                <systemProperty>
                                    <!-- Instead of the schema's own package, spot_stream -->
                                    <key>sbe.target.namespace</key>
                                    <value>com.argus.feedgateway.adapter.in.binance.sbe</value>
                                </systemProperty>
                                <systemProperty>
                                    <key>sbe.validation.stop.on.error</key>
                                    <value>true</value>
                                </systemProperty>
                                <systemProperty>
                                    <!-- Binance's schema warns (its trades group counts with uint32) and is not ours to fix -->
                                    <key>sbe.validation.warnings.fatal</key>
                                    <value>false</value>
                                </systemProperty>
                            </systemProperties>
                            <arguments>
                                <argument>${binance.sbe.schema}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>uk.co.real-logic</groupId>
                        <artifactId>sbe-tool</artifactId>
                        <version>${sbe.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-binance-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${binance.sbe.generated.dir}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Generated codecs are not counted in the coverage report or thresholds. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>com/argus/feedgateway/adapter/in/binance/sbe/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Same as agrona.jvm.args, applied by `java -jar` without extra flags -->
                            <Add-Exports>java.base/jdk.internal.misc</Add-Exports>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Used by ./mvnw spring-boot:run -->
                    <jvmArguments>${agrona.jvm.args}</jvmArguments>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
