<?xml version="1.0" encoding="UTF-8"?>
<!--
  Argus fast-path contracts (Aeron).

  Versioning rules (see contracts/README.md):
  - New fields are appended at the end of a message with sinceVersion="N" and the schema version is bumped.
  - New messages get a new templateId.
  - Breaking changes (removing, retyping or reordering fields) require a new schema id.

  Layout: fields are ordered 8 -> 4 -> 2 -> 1 bytes, char arrays last, so every 64-bit field stays 8-byte aligned.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.argus.contracts.sbe"
                   id="1"
                   version="0"
                   semanticVersion="0.2.0"
                   description="Argus fast-path contracts (Aeron)"
                   byteOrder="littleEndian">

    <types>
        <composite name="messageHeader" description="Standard SBE header, precedes every message">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>

        <composite name="groupSizeEncoding" description="Header of a repeating group">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="varStringEncoding" description="Variable-length UTF-8 string">
            <type name="length" primitiveType="uint16"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>

        <composite name="Decimal64" description="Fixed-point decimal: value = mantissa * 10^-8">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8" presence="constant">-8</type>
        </composite>

        <type name="EpochNanos" primitiveType="int64" description="Nanoseconds since the Unix epoch, UTC"/>
        <type name="Sequence" primitiveType="uint64" description="Monotonic per-publisher sequence, starts at 1"/>
        <type name="Symbol" primitiveType="char" length="24" characterEncoding="US-ASCII"
              description="Instrument symbol as the venue names it, uppercase, null-padded (e.g. BTCUSDT)"/>
        <type name="Venue" primitiveType="char" length="12" characterEncoding="US-ASCII"
              description="Venue code, uppercase, null-padded (e.g. BINANCE)"/>

        <enum name="Side" encodingType="uint8" description="Aggressor side of a trade">
            <validValue name="BUY">1</validValue>
            <validValue name="SELL">2</validValue>
        </enum>
        <enum name="Severity" encodingType="uint8" description="Severity of an alert">
            <validValue name="INFO">1</validValue>
            <validValue name="WARNING">2</validValue>
            <validValue name="CRITICAL">3</validValue>
        </enum>
    </types>

    <!-- Market data: feed-gateway and feed-player -> model-engine -->

    <sbe:message name="Trade" id="1" description="An execution that happened on the venue">
        <field name="sequence" id="1" type="Sequence"/>
        <field name="tradeId" id="2" type="int64" description="Trade id assigned by the venue"/>
        <field name="price" id="3" type="Decimal64"/>
        <field name="quantity" id="4" type="Decimal64"/>
        <field name="exchangeTimestamp" id="5" type="EpochNanos" description="Execution time on the venue"/>
        <field name="receiveTimestamp" id="6" type="EpochNanos" description="Time the gateway received it"/>
        <field name="aggressorSide" id="7" type="Side"/>
        <field name="venue" id="8" type="Venue"/>
        <field name="symbol" id="9" type="Symbol"/>
    </sbe:message>

    <sbe:message name="BestBidAsk" id="2" description="Current top of book; each update replaces the previous one">
        <field name="sequence" id="1" type="Sequence" description="Shared with Trade"/>
        <field name="bookUpdateId" id="2" type="int64" description="Book version on the venue; stale updates are dropped"/>
        <field name="bidPrice" id="3" type="Decimal64"/>
        <field name="bidQuantity" id="4" type="Decimal64"/>
        <field name="askPrice" id="5" type="Decimal64"/>
        <field name="askQuantity" id="6" type="Decimal64"/>
        <field name="exchangeTimestamp" id="7" type="EpochNanos"/>
        <field name="receiveTimestamp" id="8" type="EpochNanos"/>
        <field name="venue" id="9" type="Venue"/>
        <field name="symbol" id="10" type="Symbol"/>
    </sbe:message>

    <!--
      Model outputs: model-engine -> fast-path consumers (ADR 0014).
      Retired template ids, never to be reused: 10 (Signal, removed by ADR 0014).
    -->

    <sbe:message name="IndicatorValue" id="11" description="Values computed by an Indicator deployment">
        <field name="sequence" id="1" type="Sequence" description="Monotonic per publisher; consumers use it for gap detection"/>
        <field name="triggerSequence" id="2" type="Sequence" description="Sequence of the input event that triggered the evaluation"/>
        <field name="triggerExchangeTimestamp" id="3" type="EpochNanos" description="Event time of the triggering input"/>
        <field name="emitTimestamp" id="4" type="EpochNanos" description="Time the engine published the value"/>
        <field name="deploymentId" id="5" type="int64" description="Deployment that produced the value"/>
        <field name="deploymentRevision" id="6" type="uint32" description="Revision of the deployment: model version and parameters"/>
        <group name="values" id="7" dimensionType="groupSizeEncoding" description="One entry per output declared in ModelConfiguration, in order">
            <field name="value" id="1" type="double" description="NaN while the model does not have enough data"/>
        </group>
        <group name="instruments" id="8" dimensionType="groupSizeEncoding" description="Instruments the value refers to, in slot order">
            <field name="venue" id="1" type="Venue"/>
            <field name="symbol" id="2" type="Symbol"/>
        </group>
    </sbe:message>

    <sbe:message name="Alert" id="12" description="An alert raised by an AlertRule deployment">
        <field name="sequence" id="1" type="Sequence" description="Monotonic per publisher; consumers use it for gap detection"/>
        <field name="triggerSequence" id="2" type="Sequence" description="Sequence of the input event that triggered the evaluation"/>
        <field name="triggerExchangeTimestamp" id="3" type="EpochNanos" description="Event time of the triggering input"/>
        <field name="emitTimestamp" id="4" type="EpochNanos" description="Time the engine published the alert"/>
        <field name="deploymentId" id="5" type="int64" description="Deployment that raised the alert"/>
        <field name="deploymentRevision" id="6" type="uint32" description="Revision of the deployment: model version and parameters"/>
        <field name="severity" id="7" type="Severity"/>
        <group name="instruments" id="8" dimensionType="groupSizeEncoding" description="Instruments the alert refers to, in slot order">
            <field name="venue" id="1" type="Venue"/>
            <field name="symbol" id="2" type="Symbol"/>
        </group>
        <data name="message" id="9" type="varStringEncoding" description="Human-readable message, UTF-8"/>
    </sbe:message>

    <!-- Control -->

    <sbe:message name="Heartbeat" id="99" description="Liveness on an idle stream">
        <field name="sequence" id="1" type="Sequence" description="Last sequence published on the stream"/>
        <field name="timestamp" id="2" type="EpochNanos"/>
    </sbe:message>
</sbe:messageSchema>
