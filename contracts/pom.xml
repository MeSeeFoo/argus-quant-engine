<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.argus</groupId>
        <artifactId>argus-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>argus-contracts</artifactId>

    <name>Argus :: Contracts</name>
    <description>Message contracts: SBE codecs for the fast path (Aeron) and Protobuf messages for the durable path (Kafka).</description>

    <properties>
        <sbe.schema>${project.basedir}/src/main/resources/sbe/argus-fastpath.xml</sbe.schema>
        <sbe.generated.dir>${project.build.directory}/generated-sources/sbe</sbe.generated.dir>
    </properties>

    <dependencies>
        <!-- Generated codecs are flyweights over Agrona buffers -->
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
        </dependency>
        <!-- Runtime for the generated Protobuf messages -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generates the Java codecs from the SBE schema. Sources are never committed. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-sbe-codecs</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includeProjectDependencies>false</includeProjectDependencies>
                    <includePluginDependencies>true</includePluginDependencies>
                    <mainClass>uk.co.real_logic.sbe.SbeTool</mainClass>
                    <systemProperties>
                        <systemProperty>
                            <key>sbe.output.dir</key>
                            <value>${sbe.generated.dir}</value>
                        </systemProperty>
                        <systemProperty>
                            <key>sbe.target.language</key>
                            <value>Java</value>
                        </systemProperty>
                        <systemProperty>
                            <key>sbe.validation.stop.on.error</key>
                            <value>true</value>
                        </systemProperty>
                        <systemProperty>
                            <key>sbe.validation.warnings.fatal</key>
                            <value>true</value>
                        </systemProperty>
                    </systemProperties>
                    <arguments>
                        <argument>${sbe.schema}</argument>
                    </arguments>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>uk.co.real-logic</groupId>
                        <artifactId>sbe-tool</artifactId>
                        <version>${sbe.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-sbe-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${sbe.generated.dir}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Generates the Java messages from src/main/protobuf. Sources are never committed. -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-protobuf-messages</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <fatalWarnings>true</fatalWarnings>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Generated codecs and messages are not counted in the coverage report or thresholds. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>com/argus/contracts/sbe/**</exclude>
                        <exclude>com/argus/contracts/proto/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
